# Only the game ships: index.html, src/, styles/, assets/ and game/ (the runner). Vercel builds
# dist/ from these with npm run build (tools/build-dist.cjs, which also leaves out package.json,
# its lock file and tools/: uploaded for the build, never shipped).
docs/
tests/
source-art/
node_modules/
dist/
README.md
.env*
.git/
.gitignore
.gitattributes
.codex/
.agents/
.thumbnail
.DS_Store
assets/audio/source/
# the words as a script, only for a page opened off the disk (file://); over http the JSON is fetched
src/i18n/locales.js
# the game's modules concatenated, only for game/index.html opened off the disk; over http its modules load
game/js/game.bundle.js
game/README.md
# (No rule for a root locales.json: a bare `locales.json` here also matched src/i18n/locales.json, the words of every
# language, so no deployment since 2 Nov carried them and ?lan= showed English. A master kept beside the project is
# not in the repository, so it never reaches the deployment anyway.)
